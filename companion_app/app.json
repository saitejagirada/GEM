{
  "expo": {
    "name": "GeM National Portal",
    "slug": "gem-mobile-companion",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0B3B60"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.gem.companion"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0B3B60"
      },
      "package": "gov.gem.companion",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": []
  }
}
